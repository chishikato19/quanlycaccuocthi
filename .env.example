# Database URL (PostgreSQL từ Neon Postgres, Supabase, Vercel Postgres, hoặc Docker local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/van_thu?schema=public"

# Khóa bảo mật phiên đăng nhập Server-side Session (tùy chọn, mặc định tự sinh an toàn)
SESSION_SECRET="your-ultra-secure-random-secret-key-at-least-32-chars"

DEFAULT_USER_PIN="1234"

# Google Drive Apps Script Webhook hoặc Service Account (tùy chọn)
GOOGLE_DRIVE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"
